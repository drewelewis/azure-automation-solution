# Azure Core Configuration
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id

# Azure Automation Configuration
AZURE_AUTOMATION_ACCOUNT=your-automation-account
AZURE_AUTOMATION_RESOURCE_GROUP=your-automation-rg
AZURE_AUTOMATION_REGION=eastus2
AZURE_AUTOMATION_REGISTRATION_URL=your-automation-registration-url
AZURE_AUTOMATION_PRINCIPAL_ID=your-automation-principal-id


# Environment Configuration
AZURE_ENVIRONMENT=dev
PYTHON_PATH=.
LOG_LEVEL=INFO

# Local Development Settings
USE_MANAGED_IDENTITY=false
AZURE_CLI_AUTH=true

# Edge Gateway Configuration
EDGE_GATEWAY_IP=your-edge-gateway-ip

# Network Security Group Configuration
AZURE_NSG_RESOURCE_GROUP=your-nsg-rg
AZURE_NSG_NAME=your-nsg-name

# Key Vault Configuration
AZURE_KEYVAULT_NAME=your-keyvault-name
AZURE_KEYVAULT_RESOURCE_GROUP=your-keyvault-rg
AZURE_BACKUP_STORAGE_ACCOUNT=your-backup-storage-account

# Key Vault Access Policy Configuration
# Object IDs for users/service principals that need Key Vault access
KEYVAULT_ADMIN_OBJECT_ID=your-admin-object-id
KEYVAULT_APP_OBJECT_ID=your-app-object-id
KEYVAULT_READER_OBJECT_ID=your-reader-object-id
